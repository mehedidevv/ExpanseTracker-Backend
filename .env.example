# Copy to .env and fill in. .env is git-ignored and loaded automatically by Spring Boot.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

DB_NAME=expense_tracker
DB_URL=jdbc:postgresql://localhost:5432/expense_tracker
DB_USERNAME=expense
DB_PASSWORD=expense

# REQUIRED. At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated origin patterns
CORS_ALLOWED_ORIGINS=*

# Integration tests: used when Docker is not available
TEST_DB_URL=jdbc:postgresql://localhost:5432/expense_tracker_test

# Email (OTP codes). MAIL_ENABLED=false prints codes to the server log instead of sending (dev).
# Gmail: MAIL_PASSWORD must be a 16-char App Password (Google Account → Security → App passwords).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=
MAIL_FROM=
OTP_TTL=10m
OTP_RESEND_COOLDOWN=60s
